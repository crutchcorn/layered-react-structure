{
  "name": "lrs-eslint-plugin",
  "version": "0.2.0",
  "type": "module",
  "description": "ESLint rules for Layered React Structure (LRS): enforce React import boundaries and an optional file and folder structure.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "typescript",
    "layered-react-structure",
    "lrs",
    "import-boundaries",
    "project-structure"
  ],
  "author": {
    "name": "Corbin Crutchley",
    "url": "https://github.com/crutchcorn"
  },
  "homepage": "https://github.com/crutchcorn/layered-react-structure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crutchcorn/layered-react-structure.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/crutchcorn/layered-react-structure/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run build",
    "test:eslint": "eslint .",
    "test:lib": "vitest run",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^10.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/utils": "^8.71.1",
    "eslint": "^10.12.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "eslint-plugin-project-structure": "^3.14.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "nx": {
    "includedScripts": [
      "build",
      "test:eslint",
      "test:lib",
      "test:types"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test:lib": {
        "dependsOn": [
          "build",
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": []
      },
      "test:types": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
