{
  "name": "lrs-root",
  "private": true,
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "type": "module",
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "preinstall": "node -e \"if(process.env.CI == 'true') {console.log('Skipping preinstall...')} else {process.exit(1)}\" || npx -y only-allow pnpm",
    "test": "pnpm run test:ci",
    "test:pr": "nx affected --targets=test:sherif,test:knip,test:eslint,test:lib,test:e2e,test:types,test:build,build",
    "test:ci": "pnpm gen:openapi && pnpm test:sherif && pnpm test:knip && pnpm -r test:eslint && pnpm -r test:types && pnpm -r build && pnpm -r test:lib && pnpm test:e2e",
    "test:eslint": "pnpm -r test:eslint",
    "test:format": "pnpm run prettier --check",
    "test:sherif": "sherif",
    "test:lib": "pnpm gen:openapi && pnpm -r test:lib",
    "test:lib:dev": "pnpm run test:lib && nx watch --all -- pnpm run test:lib",
    "test:build": "nx affected --target=test:build",
    "test:types": "pnpm gen:openapi && pnpm -r test:types",
    "test:knip": "knip",
    "build": "pnpm gen:openapi && pnpm -r build",
    "build:all": "nx run-many --target=build",
    "dev": "pnpm gen:openapi && pnpm --parallel --filter \"./apps/*\" dev",
    "prettier": "prettier --ignore-unknown .",
    "prettier:write": "pnpm run prettier --write",
    "preview": "pnpm --filter @demo-proj/frontend preview",
    "start:api": "pnpm --filter @demo-proj/backend start",
    "gen:openapi": "pnpm -r gen:openapi",
    "test:e2e": "pnpm --filter @demo-proj/frontend test:e2e"
  },
  "nx": {
    "includedScripts": [
      "test:knip",
      "test:sherif"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "knip": "^6.40.0",
    "nx": "23.3.0",
    "prettier": "^3.9.9",
    "sherif": "^1.13.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
